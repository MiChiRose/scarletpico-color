; 16-bit stereo Philips I2S. Side-set bit 0 = BCLK, bit 1 = LRCLK.
; LRCLK changes with the PREVIOUS channel's LSB (one-bit I2S delay).
; 64 PIO cycles per stereo frame; MSB first, left in bits 31..16.
.program scarlet_i2s
.side_set 2
.wrap_target
left_bits:
    out pins, 1          side 0b00
    jmp x-- left_bits    side 0b01
    out pins, 1          side 0b10
    set x, 14            side 0b11
right_bits:
    out pins, 1          side 0b10
    jmp x-- right_bits   side 0b11
    out pins, 1          side 0b00
    set x, 14            side 0b01
.wrap
